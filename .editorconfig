root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true

[*.java]
indent_size = 4
max_line_length = 140
