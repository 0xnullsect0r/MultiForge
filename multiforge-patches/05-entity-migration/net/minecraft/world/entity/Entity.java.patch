+    /** MultiForge: the rest of {@link #handlePortal}, at the barrier. */
+    private void mfFinishPortal(ServerLevel level, PortalProcessor process) {
+        if (this.isRemoved() || this.level() != level) return;
+        TeleportTransition teleportTransition = process.getPortalDestination(level, this);
+        if (teleportTransition != null) {
+            ServerLevel newLevel = teleportTransition.newLevel();
+            if (level.isAllowedToEnterPortal(newLevel) && (newLevel.dimension() == level.dimension() || this.canTeleport(level, newLevel))) {
+                this.teleport(teleportTransition);
+            }
+        }
+    }
+
+    static final class MfLambdas {
+        private MfLambdas() {}
+
+        static net.multiforge.runtime.region.RegionPhase.Deferred finishPortal(Entity entity, ServerLevel level, PortalProcessor process) {
+            return () -> entity.mfFinishPortal(level, process);
+        }
+    }
