+    /**
+     * MultiForge (multiforge-patches/02-region-tick/): these synchronizers' maps are the
+     * server thread's. With a debug client subscribed, a call from a region worker (or
+     * pumped while workers run) replays at the barrier. Kept out of this class so a
+     * lambda does not renumber Vanilla's.
+     */
+    static final class MfLambdas {
+        private MfLambdas() {}
+
+        static net.multiforge.runtime.region.RegionPhase.Deferred registerChunk(LevelDebugSynchronizers s, LevelChunk chunk) { return () -> s.registerChunk(chunk); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred dropChunk(LevelDebugSynchronizers s, ChunkPos pos) { return () -> s.dropChunk(pos); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred registerBlockEntity(LevelDebugSynchronizers s, BlockEntity blockEntity) { return () -> s.registerBlockEntity(blockEntity); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred dropBlockEntity(LevelDebugSynchronizers s, BlockPos pos) { BlockPos immutable = pos.immutable(); return () -> s.dropBlockEntity(immutable); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred registerEntity(LevelDebugSynchronizers s, Entity entity) { return () -> s.registerEntity(entity); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred dropEntity(LevelDebugSynchronizers s, Entity entity) { return () -> s.dropEntity(entity); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred startTrackingChunk(LevelDebugSynchronizers s, ServerPlayer player, ChunkPos pos) { return () -> s.startTrackingChunk(player, pos); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred startTrackingEntity(LevelDebugSynchronizers s, ServerPlayer player, Entity entity) { return () -> s.startTrackingEntity(player, entity); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred registerPoi(LevelDebugSynchronizers s, PoiRecord poi) { return () -> s.registerPoi(poi); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred updatePoi(LevelDebugSynchronizers s, BlockPos pos) { BlockPos immutable = pos.immutable(); return () -> s.updatePoi(immutable); }
+        static net.multiforge.runtime.region.RegionPhase.Deferred dropPoi(LevelDebugSynchronizers s, BlockPos pos) { BlockPos immutable = pos.immutable(); return () -> s.dropPoi(immutable); }
+    }
