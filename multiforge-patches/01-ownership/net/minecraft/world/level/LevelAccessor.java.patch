     default void scheduleTick(BlockPos p_186465_, Block p_186466_, int p_186467_, TickPriority p_186468_) {
+        // MultiForge (multiforge-patches/01-ownership/): guard for ServerLevel
+        // callers (the main runtime path). Skip for pure worldgen carriers
+        // (WorldGenRegion) that call this from Util.backgroundExecutor threads
+        // during feature/structure gen — those are single-owner for the region's
+        // lifetime, so guarding+rerouting them would lose scheduled ticks
+        // against a stale WorldGenRegion scope. Discriminator: WorldGenLevel
+        // AND NOT ServerLevel (ServerLevel implements both — the earlier
+        // fix that skipped on WorldGenLevel alone silently regressed the
+        // guard for the main runtime path).
+        if (this instanceof net.minecraft.world.level.WorldGenLevel
+                && !(this instanceof net.minecraft.server.level.ServerLevel)) {
+            this.getBlockTicks().schedule(this.createTick(p_186465_, p_186466_, p_186467_, p_186468_));
+            return;
+        }
+        if (!net.multiforge.neoforge.OwnershipGuard.canMutate("LevelAccessor.scheduleTick")) {
+            net.multiforge.neoforge.OwnershipGuard.reroute(
+                    "LevelAccessor.scheduleTick", () -> this.scheduleTick(p_186465_, p_186466_, p_186467_, p_186468_));
+            return;
+        }
         this.getBlockTicks().schedule(this.createTick(p_186465_, p_186466_, p_186467_, p_186468_));
     }
 
