# Gradle
.gradle/
build/
out/
bin/

# Vendored NeoForge workspace (populated by :setup)
# NeoForge is vendored as a fork under upstream/neoforge-1.21.1/. The
# source tree at the checkout root (build.gradle, patches/, src/,
# buildSrc/, gradle/, etc.) IS committed — this repo IS the fork.
# What we exclude is anything regenerable or per-user:

# Build outputs and Gradle caches
upstream/neoforge-1.21.1/.gradle/
upstream/neoforge-1.21.1/build/
upstream/neoforge-1.21.1/**/build/
upstream/neoforge-1.21.1/**/.gradle/

# Nested git dir from the initial clone (we're the git root now)
upstream/neoforge-1.21.1/.git/

# Per-user run dirs
upstream/neoforge-1.21.1/projects/*/run/

# Decompiled Vanilla source — regenerated by `./gradlew :setup` in the
# nested build. Committing it would add ~82 MB per NeoForge point
# release; every contributor's setup produces the exact same output
# byte-for-byte from a fixed neoform_version. Keeps the repo lean.
upstream/neoforge-1.21.1/projects/*/src/main/java/net/minecraft/
upstream/neoforge-1.21.1/projects/*/src/main/resources/

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/settings.json.template
.project
.classpath
.settings/
nbproject/
nbactions*.xml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs / runtime — root-anchored so nested `logs/` in module resources
# and Java packages named `world`/`entity` are not matched.
/logs/
*.log
/crash-reports/
hs_err_pid*.log
replay_pid*.log

# Local run dirs (root-anchored)
/run/
/run-*/
/world/
/world_nether/
/world_the_end/
/level.dat*
/session.lock
/usercache.json
/banned-players.json
/banned-ips.json
/whitelist.json
/ops.json
/eula.txt

# Installer signing keys (never commit private keys)
# The installer jar is Ed25519-signed for supply-chain integrity even
# under GPL-3 — the license moved to OSS, the code-signing did not.
*.private.pem
*.priv
private-key.*
*-signing-key.*

# Docker
.docker-build/

# Bench output
bench/reports/
bench/tmp/

# M9 Phase 7 wall-clock verification world captures.
# Only summary logs (latest.log, boot.log, elapsed-sec.txt,
# world-size-bytes.txt) and diff outputs land in git.
docs/verification/m9/**/world/
# The global `*.log` rule above ignores latest.log, boot.log, diff logs
# etc. anywhere; force them back in under docs/verification/ so the
# summary artefacts committed alongside the results doc are tracked.
!docs/verification/**/*.log

# Node (docs site future)
node_modules/

# Claude Code session state (subagent worktrees, plans, etc.).
.claude/
